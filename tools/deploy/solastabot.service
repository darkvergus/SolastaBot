[Unit]
Description=Solasta unified paper portfolio and collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=solasta
Group=solasta
WorkingDirectory=/opt/solastabot
ExecStart=/opt/solastabot/SolastaBot.Host serve --settings /etc/solastabot/unified-paper.json --state /var/lib/solastabot/unified
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
StateDirectory=solastabot
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/solastabot
Environment=DOTNET_ENVIRONMENT=Production

[Install]
WantedBy=multi-user.target
